<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlundraGame\AlundraGame.csproj" />
    <ProjectReference Include="..\AlundraEngine\AlundraEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="EntityNames.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="map_names.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e11c-musique.md, slice C1, D-C-2: g_defaultSoundOffsetList (StaticVariables.cs),
         483 raw entries, generated once from that exact array (see this repo's converter-side
         MusicIndexCatalogReader.cs for the consumer that applies the §1.1 semantics). -->
    <None Update="MapMusicIndex.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e12-dialogues.md, slice E12.b, D-E12-2: g_fontCharWidthTable
         (StaticVariables.cs:9484), 256 raw code;advance rows, generated once from that exact array
         (stride 5, advance at [code*5] - verified against all four TextDecoder.cs consumption sites,
         :214/:237/:448/:607, which all read that same offset). See this repo's converter-side
         FontCharWidthCatalogReader.cs for the consumer, which applies its own raw-code -> codepoint
         mapping. -->
    <None Update="FontCharWidths.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e12-dialogues.md, slice E12.b, D-E12-6: the ETC index table (1024 int16, index;value)
         is the first 1024 int16 of the game's own ETC_RES.R file - mirrors EtcResR.cs:7-13's exact
         read. Not in the decompiled code at all, so unlike every other CSV in this project it cannot
         be regenerated from a literal array - it was dumped once, straight off
         "<gamePath>\DATA\ETC_RES.R" (France release), with a throwaway console tool that read the
         same 1024 int16 header EtcResR's constructor reads, then deleted. See this repo's
         converter-side EtcIndexCatalogReader.cs for the consumer. -->
    <None Update="EtcIndexTable.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e11b-opcodes-audio.md, slice B3, D-B-7: VabIndexByMapId (SoundBin.cs:2335), 483
         raw entries (map ids 0..482, values 0..76, 74 distinct), generated once from that exact
         array, same "raw port" precedent as MapMusicIndex.csv above (interpreting the value - which
         sound group a map's own VAB belongs to - is the CONSUMER's job; see this repo's
         converter-side MapSoundGroupIndexCatalogReader.cs for the consumer that applies it). -->
    <None Update="MapSoundGroupIndex.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e13c-icones-hud.md, slice S1.b, D-E13C-2: g_itemsProperties (StaticVariables.cs:737-838),
         100 raw rows (item_id 0..99, one row per entry) of that exact 5-ushort-wide array (columns
         documented at StaticVariables.cs:729-734: slot, replace_flag, priority, max_count, icon). Same
         "linked, not copied" precedent as MapSoundGroupIndex.csv above: the analyser owns this table,
         this repo's converter only reads it and republishes it raw (see this repo's converter-side
         ItemsPropertiesCatalogReader.cs, slice S2, for the consumer). -->
    <None Update="ItemsProperties.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e13c-icones-hud.md, slice S1.b, D-E13C-4: the item -> portrait sprite signature
         correspondence, 88 rows, one per exploitable icon column of g_itemsProperties (item 42's icon
         column names a sprite-table entry that SpriteInfo.cs:93-101 never builds - "missing record" -
         so it is absent here, see docs/plan-e13c-icones-hud.md S1.a). Not a raw port of a single
         decompiled array like the others: it is the result of AlundraDataExtractor's probe-portraits
         probe (Program.cs) reading GetPortraitImageset for the 89 icon values straight off the game
         binary. Same "linked, not copied" reasoning: this repo owns the measurement, this repo's
         converter only reads it and republishes it raw (see this repo's converter-side
         ItemPortraitCatalogReader.cs, slice S2, for the consumer, which resolves each signature to the
         .sprite asset id the converter already emitted for it). -->
    <None Update="ItemPortrait.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- docs/plan-e13c-icones-hud.md, slice S1.c, D-E13C-2: g_itemDropProperties (StaticVariables.cs:841),
         98 raw rows (item_id 0..97, the bound of the new-game unlock loop, GameInitializer.cs:408), the
         four byte fields as the array holds them: Field1, SoundSfxIndex, Field3, Field4. Field3 stays whole:
         its high bit is the item unlocked at the start of a new game (GameInitializer.cs:402) and its low
         seven bits are read on their own by PlayerManager. Field0 is left out, and on purpose: it is a string
         the decompilation did not recover, empty on all 98 records, so it carries nothing to republish.
         Same "linked, not copied" precedent as the two tables above: the converter only reads it and
         republishes it raw (its ItemDropPropertiesCatalogReader.cs, slice S2.b). -->
    <None Update="ItemDropProperties.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>